# Get this from your Neon project dashboard → Connection Details
# Use the direct (non-pooled) URL for long-running FastAPI; switch to
# the -pooler host for serverless/edge deployments.
# asyncpg requires sslmode=require — Neon enforces TLS.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql+asyncpg://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

ENVIRONMENT=local

# Disposable loopback database used only by `lab simulate`.
# `docker compose up -d db` exposes the database on host port 55433.
LAB_TEST_PG_URL=postgresql://lab:lab@127.0.0.1:55433/lab

# Hosted reference-agent model
MODEL_PROVIDER=openai
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=

# Optional second hosted model for the Phase 2 cost comparison
MODEL_CANDIDATE_PROVIDER=
MODEL_CANDIDATE_NAME=
MODEL_CANDIDATE_BASE_URL=
MODEL_CANDIDATE_API_KEY=

# Optional OpenAI-compatible policy retrieval embeddings. If omitted, an
# OpenAI agent model key is reused. Set RETRIEVAL_ENABLED=false to keep the
# database-only policy lookup path.
RETRIEVAL_ENABLED=true
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
RETRIEVAL_CORPUS_VERSION=policy-v1

# Print sanitized OpenTelemetry spans locally
OTEL_TRACING_ENABLED=false

# Set to true to emit spans to LangSmith during development
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=simulate
LANGSMITH_OTLP_ENDPOINT=

# Phase 8 Modal Cloud Runner settings
MODAL_ENABLED=false
MODAL_APP_NAME=simulate-mvp
CONTROL_PLANE_PUBLIC_URL=
INVESTIGATION_HEARTBEAT_SILENCE_S=90
SIMULATE_LIVE_E2E=
